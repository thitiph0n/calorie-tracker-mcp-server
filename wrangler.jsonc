/**
 * Wrangler configuration for Calorie Tracker MCP Server
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calorie-tracker-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-25",
  "compatibility_flags": ["nodejs_compat"],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prod-calorie-tracker",
      "database_id": "f5f996b7-76a6-4ab7-b640-594a674d4ef7"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "be2acdb7c72d426ca8230112af52aee5"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "ADMIN_API_KEY": "dev-secret-change-in-production"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "CalorieTrackerMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CalorieTrackerMCP"]
    }
  ],
}
